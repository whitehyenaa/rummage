{
	"schemaVersion": 1,
	"id": "rummage",
	"version": "${version}",
	"name": "Rummage",
	"description": "Remembers what's in every chest you open. Search from your inventory and the right containers light up.",
	"license": "MIT",
	"icon": "assets/rummage/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["rummage.Rummage"],
		"modmenu": ["rummage.ModMenuIntegration"]
	},
	"mixins": ["rummage.mixins.json"],
	"suggests": {
		"modmenu": "*"
	},
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
